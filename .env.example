# Copy to .env at the repository root to enable cloud sync on the desktop app.
# .env is gitignored — never commit real values.
#
# Cloud sync is entirely optional. Folio is local-first and every reading
# feature works with this file absent; only cross-device sync is disabled.
#
# Read by desktopApp/src/main/java/com/folio/reader/Main.kt (loadEnvFile).
# Equivalent environment variables, which take lower precedence than a value
# entered in Settings > Advanced but are read if this file is missing:
#   FOLIO_FB_PROJECT_ID, FOLIO_FB_API_KEY, FOLIO_FB_STORAGE_BUCKET
#
# On Android the same values come from Settings > Advanced, or from string
# resources named folio_fb_project_id / folio_fb_api_key.

# Firebase project ID (Project Settings > General).
projectId=your-firebase-project-id

# Firebase Web API key (Project Settings > General > Web API Key).
# Metadata sync needs only projectId + apiKey.
apiKey=your-firebase-web-api-key

# Optional. Set only if you want EPUB file and cover sync through Cloud
# Storage; leave unset and sync stays metadata-only.
# storageBucket=your-project-id.appspot.com
