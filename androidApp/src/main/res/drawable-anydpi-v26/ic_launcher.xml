<?xml version="1.0" encoding="utf-8"?>
<!--
  API 26+ launcher icon. The layers are separate so the launcher can parallax,
  mask and theme them; the monochrome layer is what Android 13+ tints to the
  wallpaper palette. Pre-26 devices fall back to drawable/ic_launcher.xml.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
