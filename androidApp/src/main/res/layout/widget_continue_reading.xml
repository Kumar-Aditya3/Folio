<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="4dp" android:background="@android:color/transparent">
    <ImageView android:id="@+id/widget_glass" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/widget_glass_base" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="14dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_eyebrow" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="FOLIO" android:textSize="10sp" android:letterSpacing="0.24"
                android:textColor="#D4C4A9" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/widget_format" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="YOUR READING ROOM" android:textSize="8sp" android:letterSpacing="0.1"
                android:textColor="#B8C1CE" android:fontFamily="sans-serif-medium" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/widget_cover" android:layout_width="68dp" android:layout_height="92dp"
                android:layout_marginEnd="14dp" android:scaleType="fitCenter" android:visibility="gone" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/widget_cover_compact" android:layout_width="42dp" android:layout_height="62dp"
                android:layout_marginEnd="10dp" android:scaleType="fitCenter" android:visibility="gone" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Your next page awaits" android:textColor="#F3F0E9" android:textSize="22sp"
                    android:fontFamily="serif" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="A little time, a good story." android:textColor="#B8C1CE"
                    android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
                <ImageView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="6dp"
                    android:layout_marginTop="9dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_action" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Continue reading" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                android:textColor="#D4C4A9" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_progress_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="10dp" android:text="42%" android:textSize="10sp" android:fontFamily="sans-serif-medium"
                android:textColor="#B8C1CE" android:maxLines="1" />
            <ImageView android:id="@+id/widget_read_arrow" android:layout_width="26dp" android:layout_height="26dp"
                android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
