<?xml version="1.0" encoding="utf-8"?>
<!--
  §redesign launch window pop — the exiting (Folio) window on OVERRIDE_TRANSITION_CLOSE.
  Reverse of the open pop: shrinks from full size to 0.96 about the window centre and
  fades out.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <scale
        android:fromXScale="1.0"
        android:toXScale="0.90"
        android:fromYScale="1.0"
        android:toYScale="0.90"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="240" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0"
        android:duration="240" />
</set>
