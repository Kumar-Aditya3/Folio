<?xml version="1.0" encoding="utf-8"?>
<!--
  §redesign launch window pop — the entering (Folio) window on OVERRIDE_TRANSITION_OPEN.
  Scales up from 0.92 to full size about the window centre and fades in. Used only on
  API 34+ (Activity.overrideActivityTransition); packaged everywhere.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <scale
        android:fromXScale="0.86"
        android:toXScale="1.0"
        android:fromYScale="0.86"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="320" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="300" />
</set>
