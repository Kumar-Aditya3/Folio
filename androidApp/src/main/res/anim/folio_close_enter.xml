<?xml version="1.0" encoding="utf-8"?>
<!--
  §redesign launch window pop — the entering (revealed) window on OVERRIDE_TRANSITION_CLOSE.
  Reverse of folio_open_exit: grows from 0.96 back to full size about its centre and fades in.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <scale
        android:fromXScale="0.96"
        android:toXScale="1.0"
        android:fromYScale="0.96"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="180" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="180" />
</set>
