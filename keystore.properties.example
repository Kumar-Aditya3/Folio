# Copy to keystore.properties at the repository root to enable release signing.
# keystore.properties is gitignored — never commit real credentials.
#
# When this file is absent, androidApp/build.gradle.kts skips the release
# signingConfig entirely and debug builds use the default debug keystore.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore folio-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias folio

storeFile=folio-release.jks
storePassword=changeme
keyAlias=folio
keyPassword=changeme
