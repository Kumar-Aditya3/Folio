# Upstream Mihon checkout used only as vendoring reference; the runtime itself
# lives under shared/src/androidMain/kotlin/{eu,mihon,tachiyomi,logcat}.
mihon-main/

# Device database pulls (adb) used for local debugging; *.db alone misses the
# SQLite -shm/-wal companions.
dbpull/

# Personal bug-report captures (own library, highlights, stats). Kept locally
# for reference; they are the reader's private reading life, not repo assets.
screenshot/
